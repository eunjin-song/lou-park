# Local play uses npm run play and does not need these.
# The public host sets PARK_PUBLIC and PORT. Do not put them in frontend code.

# PARK_PUBLIC=1
# PORT=10000
# PARK_WS_PORT=8787
# PARK_ALLOWED_ORIGINS=https://lou-park.onrender.com
# Local checks only. The public park stays at 600000 (10 minutes). Do not set this on Render.
# PARK_POOP_DELAY_MS=600000
